{
  "name": "meterproof",
  "version": "1.0.0",
  "description": "MeterProof: check municipal bills against your real meter readings and lodge Section 102 disputes with an evidence pack.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2"
  }
}
