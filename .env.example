# Copy to .env for local development, or set these in your host's dashboard.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL (no trailing slash). PayFast sends payment notifications here.
BASE_URL=http://localhost:3000
# Folder for the SQLite database, photos and the dev email outbox.
DATA_DIR=./data
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=you@example.com
BRAND_NAME=MeterProof
SUPPORT_EMAIL=support@meterproof.co.za

# --- Business details (receipts, Terms, Privacy Policy) -----------------
BUSINESS_LEGAL_NAME=Your Name t/a MeterProof
BUSINESS_ADDRESS=Your business address, City, Postal code
# Leave empty unless VAT registered; when set, receipts become tax invoices.
BUSINESS_VAT_NUMBER=
INFORMATION_OFFICER=Your Name

# --- PayFast ------------------------------------------------------------
# "sandbox" uses PayFast's public test account (defaults below). Switch to
# "live" with your own merchant details once sandbox testing passes.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
# Set to 1 to also check that payment notifications come from PayFast's servers.
PAYFAST_CHECK_IP=0

# --- Direct EFT into your bank account (shown on the EFT checkout page) --
EFT_ENABLED=1
EFT_BANK_NAME=FNB
EFT_ACCOUNT_NAME=Your Name
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=250655
EFT_ACCOUNT_TYPE=Cheque

# --- Email (any SMTP provider: Brevo, Postmark, Amazon SES, Mailgun...) --
# Leave SMTP_HOST empty in development: emails are saved to DATA_DIR/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MeterProof <no-reply@meterproof.co.za>

# --- Development only ----------------------------------------------------
# Shows a "Simulate successful payment" button on checkout (never in production).
ALLOW_DEV_PAYMENTS=1
DISABLE_SCHEDULER=0
